# Database (PostgreSQL)
DATABASE_URL="postgres://user:password@host:port/db_name?sslmode=require"

# Cloudflare Images
CF_API_TOKEN="your_cloudflare_api_token"
CF_ACCOUNT_ID="your_cloudflare_account_id"
CF_ACCOUNT_HASH="your_cloudflare_account_hash"
OPENAI_API="your_openai_api_key_or_openrouter"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
FAL_API="your_fal_api_key_here"

# JWT Auth Secrets (Generate using `openssl rand -hex 64` or similar)
JWT_REFRESH_SECRET="your_jwt_refresh_secret"
JWT_SECRET="your_jwt_secret"

# Social Links
PUBLIC_GITHUB_URL="https://github.com/yourusername"
PUBLIC_TWITTER_URL="https://twitter.com/yourusername"

# Site Config
PUBLIC_SITE_NAME="블로그"
PUBLIC_SITE_DESCRIPTION="개발, 설계, 그리고 일상에 대한 이야기를 담은 블로그입니다."
PUBLIC_SITE_URL="https://example.com"
PUBLIC_SITE_AUTHOR="Admin"
