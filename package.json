{
    "name": "svelte-shadcn-blog",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "test": "node --test --experimental-strip-types tests/**/*.test.ts",
        "format": "prettier --write .",
        "lint": "prettier --check . && eslint .",
        "verify": "pnpm check && pnpm test && pnpm build",
        "verify:strict": "pnpm check && pnpm lint && pnpm test && pnpm build",
        "register:admin": "node scripts/register-admin.mjs",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "db:drop": "node src/lib/server/db/reset.ts"
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.0",
        "@eslint/js": "^9.39.1",
        "@internationalized/date": "^3.10.1",
        "@lucide/svelte": "^0.561.0",
        "@sveltejs/adapter-node": "^5.4.0",
        "@sveltejs/kit": "^2.49.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.17",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.1.8",
        "@types/node": "^22",
        "bits-ui": "^2.15.4",
        "clsx": "^2.1.1",
        "drizzle-kit": "^0.31.8",
        "drizzle-orm": "^0.45.0",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.13.1",
        "globals": "^16.5.0",
        "jsrepo": "^3.0.9",
        "layerchart": "2.0.0-next.43",
        "mode-watcher": "^1.1.0",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "rehype-raw": "^7.0.0",
        "svelte": "^5.45.6",
        "svelte-check": "^4.3.4",
        "svelte-sonner": "^1.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.17",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1",
        "unist-util-visit": "^5.0.0",
        "vite": "^7.2.6"
    },
    "dependencies": {
        "@fal-ai/client": "^1.9.4",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "dotenv": "^17.2.3",
        "jose": "^6.1.3",
        "katex": "^0.16.33",
        "openai": "^6.25.0",
        "postgres": "^3.4.7",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^3.23.0",
        "svelte-exmarkdown": "^5.0.2",
        "zod": "^4.3.5"
    }
}
